# Key NAMES only. Copy to .env.local and fill in.
# Everything the chat backend, the agent console, the WhatsApp bridge and the
# enquiry form need.

# Database
MONGODB_URI=

# Auth — signs agent sessions and per-conversation chat tokens
JWT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Pusher — NEXT_PUBLIC_* are exposed to the browser and are not secrets
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
WHATSAPP_LEAD_TEMPLATE=
WHATSAPP_TEMPLATE_LOCALE=
WHATSAPP_DRY_RUN=

# EmailJS — the enquiry form posts from the visitor's browser, so all three are
# compiled into the client bundle by design: set them before building. The
# control is the "Allowed origins" list in the EmailJS dashboard, which should
# hold the production domain and nothing else. See lib/emailjs.ts.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Logging
LOG_LEVEL=

# Rate limiting — the request header that carries the real caller IP. Use the
# one your host sets itself; any other header can be written by the client.
#   Netlify     x-nf-client-connection-ip
#   Vercel      x-real-ip
#   Cloudflare  cf-connecting-ip
#   nginx       x-real-ip, only when nginx sets: proxy_set_header X-Real-IP $remote_addr;
# Empty means Vercel's header when VERCEL is set, otherwise Netlify's, with a
# warning in the production log. See README.md.
TRUSTED_IP_HEADER=
