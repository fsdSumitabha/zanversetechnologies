# Key NAMES only. Copy to .env.local and fill in.
# Everything the chat backend, the agent console, the WhatsApp bridge and the
# enquiry form need.

# Database
MONGODB_URI=

# Auth — signs agent sessions and per-conversation chat tokens
JWT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Pusher — NEXT_PUBLIC_* are exposed to the browser and are not secrets
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
WHATSAPP_LEAD_TEMPLATE=
WHATSAPP_TEMPLATE_LOCALE=
WHATSAPP_DRY_RUN=

# Logging
LOG_LEVEL=

# Rate limiting — the request header that carries the real caller IP. Use the
# one your host sets itself; any other header can be written by the client.
#   Netlify     x-nf-client-connection-ip
#   Vercel      x-real-ip
#   Cloudflare  cf-connecting-ip
#   nginx       x-real-ip, only when nginx sets: proxy_set_header X-Real-IP $remote_addr;
# Empty means Vercel's header when VERCEL is set, otherwise Netlify's, with a
# warning in the production log. See README.md.
TRUSTED_IP_HEADER=

# Enquiry mail — the account the forms send from. See server/services/mail.service.ts.
# SMTP_PASS is a Google App Password, not the account's sign-in password: 16
# letters, no spaces. Set SMTP_USER and SMTP_PASS before building: without them
# the forms show the email address instead. MAIL_TO is where leads go; empty
# means site.email in constants/zan.ts. Only SMTP_PASS is a secret.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sales@zanversetechnologies.com
SMTP_PASS=
MAIL_TO=contact@zanversetechnologies.com
